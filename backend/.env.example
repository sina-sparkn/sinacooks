NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://recipes:change-me@localhost:5432/app?schema=public

# Auth
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
JWT_EXPIRES_IN=7d
COOKIE_NAME=recipe_token
# Set to 'none' and COOKIE_SECURE=true when frontend is hosted on a separate domain (e.g. Vercel)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# CORS: comma-separated browser origins (supports wildcards like https://*.vercel.app)
CLIENT_URL=http://localhost:5173,https://*.vercel.app

# CMS
STRAPI_URL=http://localhost:1337
STRAPI_PUBLIC_URL=http://localhost:1337
STRAPI_API_TOKEN=
STRAPI_WEBHOOK_SECRET=development_webhook_secret

CACHE_TTL_SECONDS=60
